// nagłówek pliku

// komentarz przed typem
data Shape {
    Circle(r: Int),  // koło
    Rect(w: Int, h: Int),  // prostokąt
}

data Pt { Pt(x: Int, y: Int) } where self.x >= 0 && self.y >= 0

fn f(a: Int, b: Int) -> Int
    requires a > 0  // warunek
    ensures result >= 0 || (a < 0 && b < 0)
{
    // pierwszy
    let x = a + b * 2  // suma

    var y = (a + b) * 2
    if x > 0 {
        y = 1
    } else if x < 0 {
        y = 2
    } else {
        // pusty
        y = 3
    }
    while y > 0
        invariant y >= 0
        decreases y
    {
        y = y - 1
    }
    let g = fn(z: Int) => forall i in 0..z: i >= 0
    let ok = (forall i in 0..3: i < 5) && true
    let ok2 = true && forall i in 0..3: i < 5
    let n = -(-a)
    let m = a - (b - 1) - (if a == b { 1 } else { 0 })
    match y {
        0 => { y = 1 },
        _ => { },
    }
    return if a > b { a } else { b }  // koniec
}

fn long_one(alpha: Array<Int>, beta: Array<Int>) -> Bool
    requires alpha.len == beta.len &&
        alpha.len < 1000 &&
        forall k in 0..alpha.len: alpha[k] >= 0 && beta[k] >= 0 && alpha[k] < 100
{
    let r = some_function_with_a_long_name(
        alpha,
        beta,
        alpha.len,
        beta.len,
        12345678,
        87654321,
        1111111,
    )
    r
}

fn some_function_with_a_long_name(
    a: Array<Int>,
    b: Array<Int>,
    c: Int,
    d: Int,
    e: Int,
    f: Int,
    g: Int,
) -> Bool {
    true
}
