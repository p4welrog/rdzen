fn first<T>(xs: Array<T>) -> Option<T>
    ensures match result { Some(v) => xs.len > 0 && v == xs[0], None => xs.len == 0 }
{
    if xs.len == 0 {
        None
    } else {
        Some(xs[0])
    }
}

fn uses_first() -> Int
    ensures result == 5
{
    match first([5, 6]) {
        Some(v) => v,
        None => 0,
    }
}
