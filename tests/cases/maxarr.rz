fn max_of(xs: Array<Int>) -> Int
    requires xs.len > 0
    ensures forall k in 0..xs.len: xs[k] <= result
    ensures exists k in 0..xs.len: xs[k] == result
    examples {
        max_of([3, 9, 2]) == 9
        forall xs: Array<Int>: xs.len == 0 || contains(xs, max_of(xs))
    }
{
    var m = xs[0]
    var i = 1
    while i < xs.len
        invariant 1 <= i && i <= xs.len
        invariant forall k in 0..i: xs[k] <= m
        invariant exists k in 0..i: xs[k] == m
        decreases xs.len - i
    {
        if xs[i] > m {
            m = xs[i]
        }
        i = i + 1
    }
    m
}
