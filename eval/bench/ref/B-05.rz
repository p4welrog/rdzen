fn max_subarray_sum(xs: Array<Int>) -> Int
    requires 1 <= xs.len && xs.len <= 1000
    requires forall k in 0..xs.len: -1000000000 <= xs[k] && xs[k] <= 1000000000
{
    var best = xs[0]
    var cur = xs[0]
    var i = 1
    while i < xs.len
        invariant 1 <= i && i <= xs.len
        invariant -1000000000 <= cur && cur <= 1000000000 * i
        invariant -1000000000 <= best && best <= 1000000000 * i
        decreases xs.len - i
    {
        cur = max(xs[i], cur + xs[i])
        best = max(best, cur)
        i = i + 1
    }
    best
}
