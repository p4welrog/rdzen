fn sort_array(xs: Array<Int>) -> Array<Int>
    requires xs.len <= 200
    ensures result.len == xs.len
    ensures forall k in 1..result.len: result[k - 1] <= result[k]
{
    var a = xs
    var i = 1
    while i < a.len
        invariant 1 <= i && (i <= a.len || a.len == 0) && a.len == xs.len
        invariant forall k in 1..min(i, a.len): a[k - 1] <= a[k]
        decreases a.len - i
    {
        var j = i
        while j > 0 && a[j - 1] > a[j]
            invariant 0 <= j && j <= i && i < a.len && a.len == xs.len
            invariant forall k in 1..j: a[k - 1] <= a[k]
            invariant forall k in j + 1..i + 1: a[k - 1] <= a[k]
            invariant j == i || j == 0 || a[j - 1] <= a[j + 1]
            decreases j
        {
            let t = a[j]
            a[j] = a[j - 1]
            a[j - 1] = t
            j = j - 1
        }
        i = i + 1
    }
    a
}
