fn sum_positives(xs: Array<Int>) -> Int
    requires xs.len <= 1000
    requires forall k in 0..xs.len: -1000000000 <= xs[k] && xs[k] <= 1000000000
    ensures result >= 0
{
    var s = 0
    for x in xs
        invariant 0 <= s && s <= 1000000000 * it
    {
        if x > 0 {
            s = s + x
        }
    }
    s
}
