fn lower(c: Byte) -> Int {
    if is_upper(c) {
        c + 32
    } else {
        c
    }
}

fn alnum(c: Byte) -> Bool {
    is_alpha(c) || is_digit(c)
}

fn is_palindrome_alnum(s: Str) -> Bool {
    var i = 0
    var j = s.len - 1
    while i < j
        invariant 0 <= i && j < s.len && i <= j + 1
        decreases j - i
    {
        if !alnum(s[i]) {
            i = i + 1
        } else {
            if !alnum(s[j]) {
                j = j - 1
            } else {
                if lower(s[i]) != lower(s[j]) {
                    return false
                }
                i = i + 1
                j = j - 1
            }
        }
    }
    true
}
