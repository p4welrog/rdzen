fn reverse_digits(x: Int) -> Option<Int>
    requires -2147483648 <= x && x <= 2147483647
    ensures match result { Some(v) => -2147483648 <= v && v <= 2147483647, None => true }
{
    var n = if x < 0 { -x } else { x }
    var r = 0
    while n > 0
        invariant 0 <= n && n <= 2147483648 && 0 <= r
        invariant r < 10000000000 &&
            (n < 1 || r < 1000000000) &&
            (n < 10 || r < 100000000) &&
            (n < 100 || r < 10000000) &&
            (n < 1000 || r < 1000000) &&
            (n < 10000 || r < 100000) &&
            (n < 100000 || r < 10000) &&
            (n < 1000000 || r < 1000) &&
            (n < 10000000 || r < 100) &&
            (n < 100000000 || r < 10) &&
            (n < 1000000000 || r < 1)
        decreases n
    {
        r = r * 10 + n % 10
        n = n / 10
    }
    let v = if x < 0 { -r } else { r }
    if -2147483648 <= v && v <= 2147483647 {
        Some(v)
    } else {
        None
    }
}
