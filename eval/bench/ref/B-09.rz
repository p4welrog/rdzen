fn count_inversions(xs: Array<Int>) -> Nat
    requires xs.len <= 200
{
    var c = 0
    var i = 0
    while i < xs.len
        invariant 0 <= i && i <= xs.len && 0 <= c && c <= i * xs.len
        decreases xs.len - i
    {
        var j = i + 1
        while j < xs.len
            invariant (i + 1 <= j && j <= xs.len) || j == i + 1
            invariant 0 <= c && c <= i * xs.len + j
            decreases xs.len - j
        {
            if xs[i] > xs[j] {
                c = c + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    c
}
