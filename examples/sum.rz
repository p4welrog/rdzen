// Przykład diagnostyki (specyfikacja §9): kod celowo błędny.
// Oczekiwane: E4020 — brak niezmiennika `s >= 0` (kontrprzykład indukcyjny) oraz W4400 —
// możliwe przepełnienie `s + x` (po dodaniu niezmiennika obalane rzeczywiście: [int_max, 1]).
// Poprawna wersja: ograniczenie danych w `requires` i niezmiennik `0 <= s && s <= it * M`
// albo wynik `Option<Nat>` liczony przez `checked_add`.

fn sum_nonneg(xs: Array<Nat>) -> Nat {
    var s = 0
    for x in xs {
        s = s + x
    }
    s
}
