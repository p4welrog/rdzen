"""rzc — kompilator prototypowy języka Rdzeń.

Użycie:
  rzc check PLIK.rz [--json] [--rlimit N]   weryfikacja, przykłady, diagnostyka
  rzc emit PLIK.rz [-o WYJŚCIE.py]           generowanie modułu Pythona
  rzc run PLIK.rz FUNKCJA [ARG ...]         uruchomienie funkcji w interpreterze
  rzc emit-c PLIK.rz [-o WYJŚCIE.c]          generowanie jednostki kompilacji C (GCC/Clang)
  rzc fmt PLIK.rz [-w | --check]            postać kanoniczna (wypisanie, zapis w miejscu, sprawdzenie)

Opcje check:
  --fn NAZWA[,NAZWA…]   sprawdza tylko wskazane funkcje (pozostałe są typowane; ich kontrakty
                        są używane przy wywołaniach)
  --no-cache            bez pamięci wyników (domyślnie: ~/.cache/rzc lub $RZ_CACHE); z pamięci
                        brane są tylko funkcje w pełni udowodnione przy niezmienionym tekście,
                        kontraktach i wersji kompilatora
Opcja --no-canon wyłącza błąd E0100 (program w postaci niekanonicznej).
"""
import os
import sys
import json

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from rdzen.driver import compile_source          # noqa: E402
from rdzen.diag import render_text, dumps_json   # noqa: E402


def cmd_fmt(paths, write, check):
    from rdzen.fmt import check_format
    from rdzen.diag import CompileError
    rc = 0
    for path in paths:
        src = open(path, encoding="utf-8").read()
        try:
            out, ok = check_format(src)
        except CompileError as e:
            lines = src.split("\n")
            print(render_text(e.diag, path, lines), file=sys.stderr)
            rc = 1
            continue
        if not ok:
            print(f"{path}: formatter zmieniłby drzewo składni lub komentarze — plik pozostawiony", file=sys.stderr)
            rc = 1
            continue
        if check:
            if out != src:
                print(f"{path}: postać niekanoniczna")
                rc = 1
        elif write:
            if out != src:
                open(path, "w", encoding="utf-8").write(out)
                print(f"sformatowano {path}")
        else:
            sys.stdout.write(out)
    return rc


def cmd_check(path, as_json, rlimit, canon=True, only=None, cache=True):
    src = open(path, encoding="utf-8").read()
    res = compile_source(src, rlimit=rlimit, canon=canon, only=only, cache=cache)
    if as_json:
        out = {"file": path, "diagnostics": json.loads(dumps_json(res.diags, path)), "summary": res.summary}
        print(json.dumps(out, ensure_ascii=False, indent=2))
    else:
        lines = src.split("\n")
        for d in res.diags:
            print(render_text(d, path, lines))
            print()
        s = res.summary
        if "obligations" in s:
            o = s["obligations"]
            total = sum(o.values())
            print(f"zobowiązania: {total} (udowodnione {o['proved']}, nieznane {o['unknown']}, "
                  f"obalone {o['refuted']}, indukcyjne-niejawne {o['refuted-inductive']}); "
                  f"przykłady: {s['examples']['passed']} zaliczone, {s['examples']['failed']} niezaliczone; "
                  f"dziury: {s['holes']}")
            u = s.get("units")
            if u and (u["from_cache"] or u["checked"] is not None):
                parts = []
                if u["checked"] is not None:
                    parts.append("sprawdzane: " + ", ".join(u["checked"]))
                if u["from_cache"]:
                    parts.append(f"z pamięci (bez zmian, udowodnione): {len(u['from_cache'])}")
                print("; ".join(parts))
    errors = [d for d in res.diags if d.severity == "error"]
    return 1 if errors else 0


def cmd_emit(path, out, rlimit, canon=True, backend="py"):
    from rdzen.emit_py import emit, Unsupported
    if backend == "c":
        from rdzen.emit_c import emit_c as emit
    src = open(path, encoding="utf-8").read()
    res = compile_source(src, rlimit=rlimit, canon=canon)
    errors = [d for d in res.diags if d.severity in ("error", "hole")]
    if errors:
        lines = src.split("\n")
        for d in errors:
            print(render_text(d, path, lines), file=sys.stderr)
        print("emisja przerwana: program ma błędy lub dziury", file=sys.stderr)
        return 1
    try:
        code = emit(res, os.path.basename(path))
    except Unsupported as e:
        print(f"emisja nieobsługiwana: {e}", file=sys.stderr)
        return 1
    if out:
        open(out, "w", encoding="utf-8").write(code)
        n = len(res.unproved)
        print(f"zapisano {out}; sprawdzenia dynamiczne: {n} (zobowiązania bez dowodu)")
    else:
        print(code)
    return 0


def cmd_run(path, fn, args):
    from rdzen.front import load
    from rdzen.interp import Interp, Violation, fmt
    from rdzen.parser import Parser
    src = open(path, encoding="utf-8").read()
    prog, ch, diags = load(src)
    if prog is None or any(d.severity == "error" for d in diags):
        lines = src.split("\n")
        for d in diags:
            print(render_text(d, path, lines))
        return 1
    sig = ch.fns.get(fn)
    if sig is None or sig.builtin:
        print(f"brak funkcji `{fn}`")
        return 1
    from rdzen.check import Ctx
    vals = []
    for a, (pn, pt, _) in zip(args, sig.params):
        e = Parser(a).expr()
        ch.infer(e, {}, Ctx(None), pt.bare())
        vals.append(Interp(ch).ev(e, {}))
    try:
        v, outs = Interp(ch).call_fn(sig, vals, None)
    except Violation as v:
        gdzie = f" w wierszu {v.span.line}" if v.span is not None else " przy wywołaniu z wiersza poleceń (argumenty nie spełniają warunku wstępnego)"
        print(f"pułapka: naruszenie `{v.kind}`{gdzie}" + (f" ({v.detail})" if v.detail else ""))
        return 2
    print(fmt(v))
    for (pn, _, inout), o in zip([p for p in sig.params if p[2]], outs):
        print(f"{pn} = {fmt(o)}")
    return 0


def main(argv):
    if len(argv) < 3 or argv[1] not in ("check", "run", "emit", "emit-c", "fmt"):
        print(__doc__)
        return 2
    canon = "--no-canon" not in argv
    if argv[1] == "fmt":
        files = [a for a in argv[2:] if not a.startswith("-")]
        return cmd_fmt(files, "-w" in argv, "--check" in argv)
    if argv[1] == "check":
        rl = 1_000_000
        if "--rlimit" in argv:
            rl = int(argv[argv.index("--rlimit") + 1])
        only = argv[argv.index("--fn") + 1].split(",") if "--fn" in argv else None
        return cmd_check(argv[2], "--json" in argv, rl, canon, only, "--no-cache" not in argv)
    if argv[1] in ("emit", "emit-c"):
        out = argv[argv.index("-o") + 1] if "-o" in argv else None
        return cmd_emit(argv[2], out, 1_000_000, canon, "c" if argv[1] == "emit-c" else "py")
    return cmd_run(argv[2], argv[3], argv[4:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
